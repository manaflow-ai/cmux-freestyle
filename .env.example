# Required. Get one from https://dash.freestyle.sh.
FREESTYLE_API_KEY=

# Optional. Pin to a specific manaflow-ai/cmux release tag. Defaults to latest stable.
# CMUX_RELEASE_TAG=v0.9.42

# Optional. Override the snapshot name. Defaults to cmux-freestyle-<timestamp>.
# CMUX_FREESTYLE_SNAPSHOT_NAME=cmux-freestyle-prod

# Optional. Force Freestyle to rebuild instead of reusing its layer cache.
# CMUX_FREESTYLE_SKIP_CACHE=1

# Optional. Muse Code CLI is installed in the snapshot via its official install
# script (https://dev.meta.ai/install.sh), which always resolves the current
# stable channel release. Only `latest` is supported; set to `none` to skip
# Muse in the image.
# CMUX_CLOUD_IMAGE_MUSE_VERSION=latest

# Optional. omp CLI (oh-my-pi) is installed in the snapshot via its official
# install script (https://omp.sh/install). Set to an exact `x.y.z` or `vX.Y.Z`
# version to pin, or `none` to skip omp in the image.
# CMUX_CLOUD_IMAGE_OMP_VERSION=v18.10.3
